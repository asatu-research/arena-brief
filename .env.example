# ── Database ────────────────────────────────────────────────
# Supabase (Postgres terkelola) — format connection string:
#   DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Dari dashboard Supabase → Settings → Database → "Connection string".
# - Pooler transaction mode (port 6543) direkomendasikan utk VPS (connection pooling).
# - Ganti "<ref>" dengan project ref, "<region>" misal "ap-southeast-1".
# - Username biasanya "postgres.<ref>" di mode pooler.
#
# Contoh Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.abcxyz:YourDbPassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# Bila mau Postgres lokal di VPS, pakai docker-compose.local.yml:
# DATABASE_URL=postgresql+asyncpg://arena:arena_secret@localhost:5432/arena

# ── Admin ───────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti_sesuatu_yang_kuat
SECRET_KEY=ganti_sesuatu_yang_panjang_&_acak

# ── AI (bisa dikosongkan di compose, isi via /admin > Konfigurasi) ──
GROK_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
