{
  "name": "Arena Brief — Notifikasi Admin (opsional)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * 5"
            }
          ]
        }
      },
      "id": "cron-notif",
      "name": "Cron Jumat 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://BACKEND_HOST:8000/api/dashboard/counts",
        "options": {}
      },
      "id": "http-counts",
      "name": "Cek jumlah pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true }
        },
        "conditionsUi": [
          {
            "leftValue": "={{ JSON.parse($json.body).pending }}",
            "rightValue": 0,
            "operator": { "type": "number", "operation": "gt" }
          }
        ],
        "combine": "all"
      },
      "id": "if-pending",
      "name": "Ada kandidat pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "operations": {
          "resource": "message"
        },
        "message": "Arena Brief: ada kandidat regulasi baru. Buka /admin untuk review."
      },
      "id": "tele-notif",
      "name": "Kirim Telegram (opsional)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [960, 220]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "noop-done",
      "name": "Selesai",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [960, 380]
    }
  ],
  "connections": {
    "Cron Jumat 09:00": {
      "main": [[{ "node": "Cek jumlah pending", "type": "main", "index": 0 }]]
    },
    "Cek jumlah pending": {
      "main": [[{ "node": "Ada kandidat pending?", "type": "main", "index": 0 }]]
    },
    "Ada kandidat pending?": {
      "main": [
        [{ "node": "Kirim Telegram (opsional)", "type": "main", "index": 0 }],
        [{ "node": "Selesai", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
